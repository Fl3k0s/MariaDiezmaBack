{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch API Server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/cmd/api",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "apiVersion": 2,
      "dlvFlags": [
        "--check-go-version=false"
      ]
    },
    {
      "name": "Debug Current Test File",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "apiVersion": 2,
      "dlvFlags": [
        "--check-go-version=false"
      ]
    },
    {
      "name": "Debug Current File",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${file}",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "apiVersion": 2,
      "dlvFlags": [
        "--check-go-version=false"
      ]
    },
    {
      "name": "Attach to Delve",
      "type": "go",
      "request": "attach",
      "mode": "remote",
      "port": 2345,
      "host": "127.0.0.1"
    }
  ]
}
