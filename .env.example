# Environment Configuration
PORT=8080
ENV=development

# Database Configuration
# Options: "memory" (for quick testing with zero dependencies) or "postgres"
DB_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/mariadiezma?sslmode=disable

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-mariadiezma-change-me-in-production
JWT_EXPIRATION_HOURS=24

# Default Backoffice Admin Credentials (seeded automatically)
ADMIN_EMAIL=admin@mariadiezma.com
ADMIN_PASSWORD=AdminPass123!

# Email / SMTP Configuration
# Dejar SMTP_HOST vacio para modo desarrollo (los emails se imprimen en consola con log/slog)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=tu-contraseña-o-app-password
SMTP_FROM=no-reply@mariadiezma.com
NOTIFICATION_EMAIL=citas@mariadiezma.com

# CORS Configuration (comma-separated list of origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,*
